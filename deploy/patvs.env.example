# Install the same secret on every device and controller in one installation.
PATVS_SECRET=replace-this-value

# Optional comma-separated receivers reachable across routed networks.
PATVS_SEEDS=

# Optional emitter camera override. The default is automatic V4L2 selection.
# PATVS_CAMERA=/dev/video0

# Optional receiver player override.
# PATVS_PLAYER=/usr/bin/vlc

# Stretch receiver playback to the display's physical aspect ratio, regardless
# of the source ratio. Use 4:3 for a standard CRT or 16:9 for a widescreen.
# PATVS_DISPLAY_ASPECT_RATIO=4:3
